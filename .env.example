# Copy to a file named exactly .env (not .env.txt) for local development. Never commit .env.
# PowerShell: Copy-Item .env.example .env ; notepad .env
# On Cloud Run, set these under Variables & Secrets instead (see README → Deploy).

# --- Gemini on Vertex AI ---------------------------------------------------------------
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_CLOUD_PROJECT=your-project-id   # auto-detected from gcloud if omitted

# --- Data build (scripts/build_data.py); all free ----------------------------------------
# No key needed, but the SEC and Wikipedia both refuse requests without a contact email.
# Put your own email here; it's sent in the User-Agent header to every data source.
SEC_USER_AGENT=Ticker Tutor class project your-email@example.com

# Prices: alpaca (fast, history from 2016) | tiingo (longer history, slower free plan) | stooq (no key, approximate)
PRICE_PROVIDER=alpaca
ALPACA_API_KEY=
ALPACA_API_SECRET=
TIINGO_API_KEY=

# News for the build snapshot and the live "latest headlines" tools (GDELT is used without a key)
FINNHUB_API_KEY=

# Optional: VIX and 10-year Treasury yield on the news page
FRED_API_KEY=

# --- Keeping prices current ---------------------------------------------------------------
# With the price keys above set, the app updates its own data once a day in the background (see README).
# AUTO_REFRESH=0                                            # turn that off
# REFRESH_UPLOAD_URI=gs://your-bucket/tickertutor.duckdb    # also upload each update for the deployed app

# --- Optional ----------------------------------------------------------------------------
# DATA_GCS_URI=gs://your-bucket/tickertutor.duckdb   # load a fresher database at startup
# TICKERTUTOR_DB=data/tickertutor.duckdb
# MAX_ROUNDS=3
# TIME_BUDGET_SECONDS=200
# CHAT_RATE_PER_HOUR=40
